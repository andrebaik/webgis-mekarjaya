# Foto upload admin — pola lama `uploads/*` beranchor ke root repo
# sehingga backend/uploads/ TIDAK ikut terabaikan. Jangan dilepas slash-nya.
backend/uploads/*
!backend/uploads/.gitkeep

# Dump / backup database — schema.sql & seed.sql di backend/database tetap di-track
*.sql.gz
*.dump
*.mwb.bak
backup*.sql
dump*.sql
*-backup.sql

